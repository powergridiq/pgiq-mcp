{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.powergridiq/pgiq-mcp",
  "description": "Power-market ratings, delivered cost, claims and gaps for siting a large electricity load.",
  "repository": {
    "url": "https://github.com/powergridiq/pgiq-mcp",
    "source": "github"
  },
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pgiq-mcp",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PGIQ_KEY",
          "description": "Optional PowerGridIQ API key (pk_live_...) for a higher quota.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PGIQ_API",
          "description": "Optional API base override.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
